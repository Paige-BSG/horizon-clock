{
  "name": "horizon-clock",
  "version": "0.2.0-alpha.1",
  "private": true,
  "description": "An open-source ambient wall clock for Omarchy and Linux tablets.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Paige-BSG/horizon-clock.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "node --check app.js && node --check lib/product.js && npm test && npm run build",
    "desktop:dev": "node scripts/tauri.mjs dev",
    "desktop:build": "node scripts/tauri.mjs build",
    "desktop:check": "node scripts/cargo.mjs check --locked --manifest-path src-tauri/Cargo.toml",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tauri-apps/cli": "2.12.4",
    "prettier": "3.9.10"
  }
}
